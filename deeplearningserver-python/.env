# Database settings
DATABASE_URL=mssql+pyodbc:///?odbc_connect=
DATABASE_DRIVER=Driver={ODBC Driver 17 for SQL Server};Server=localhost;Database=DeepLearningDB;Trusted_Connection=yes;

# Server settings
SERVER_PORT=8082
SERVER_HOST=0.0.0.0

# JWT settings
JWT_SECRET_KEY=your-secret-key-here
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=120

# Python training server settings
PYTHON_TRAINING_SERVER_URL=http://localhost:8000
USE_PYTHON_SERVER=False

# File paths
MIDDLE_IMAGE_PATH=/path/to/middle/images
LARGE_IMAGE_PATH=/path/to/large/images
MODEL_DIRECTORY=/path/to/models
EVALUATION_MODEL_DIRECTORY=/path/to/evaluation/models
TEMP_IMAGE_DIRECTORY=/path/to/temp/images